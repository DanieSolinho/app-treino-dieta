# Copie este arquivo para .env.local (fica fora do Git) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings › Environment Variables.

# Chave da API do Claude — console.anthropic.com › API Keys
ANTHROPIC_API_KEY=

# Código que o app pede uma vez para usar o "Escanear rótulo" (invente um, ex.: 4 palavras)
SCAN_ACCESS_CODE=

# Opcional: modelo usado (padrão claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5
